# Copy to .env.local (gitignored) and fill in. Names follow docs/BACKEND_STACK.md §12.
# The backend loads ../.env.local for `npm run dev`, `npm start`, and `npm run db:*`.
# Never commit real values.

# --- Server -------------------------------------------------------------
# Local backend port (unused on Vercel). next dev proxies /api/* here.
PORT=8787
# Browser-facing origin: next dev locally, the Vercel production domain when deployed.
PUBLIC_ORIGIN=http://localhost:3000

# --- Database (Tiger Cloud) ---------------------------------------------
# Tiger console → your service → Connect. Use sslmode=verify-full.
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/tsdb?sslmode=verify-full
# Owner connection used by dbmate (`npm run db:migrate`); may equal DATABASE_URL for the demo.
MIGRATION_DATABASE_URL=postgres://<user>:<password>@<host>:<port>/tsdb?sslmode=verify-full

# --- Auth -----------------------------------------------------------------
# Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
EMAIL_HASH_PEPPER=
# "edu" accepts any .edu address; or a list such as unc.edu,duke.edu
CAMPUS_EMAIL_DOMAINS=edu
# true enables POST /api/demo/sign-in (any campus address, no code) and logs codes instead of emailing them.
DEMO_MODE=true
# Required when DEMO_MODE=false.
RESEND_API_KEY=
OTP_EMAIL_FROM=

# --- Evidence research (Gemini) ------------------------------------------
GEMINI_API_KEY=
# Gemini 3 only (structured output + tools). Flash-Lite: $0.25/$1.50 per 1M tokens; Search grounding
# includes 5,000 free requests/month across Gemini 3.
GEMINI_MODEL=gemini-3.1-flash-lite
# Evidence research transport: gemini (direct, needs a funded Gemini API project) or openrouter.
RESEARCH_PROVIDER=gemini
# Optional fallback. Required only when RESEARCH_PROVIDER=openrouter (openrouter.ai → Keys).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Optional; read-only public scope, lifts GitHub's 60 req/h unauthenticated limit.
GITHUB_TOKEN=
# Optional, comma-separated founder-provided LinkedIn snapshot files (MARKET ARCHITECTURE §6.5).
# On Vercel, only files inside backend/ are deployed with the api service.
PROFILE_SNAPSHOT_FILES=

# --- Purchases: enable only after migration, contract and banking checks --
PURCHASES_ENABLED=false
PROGRAM_IDL_PATH= # optional override; backend/idl/prospecto.json is bundled
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=
PAYMENT_MINT=
# base58; Devnet only, never reuse on mainnet.
RELAYER_SECRET_KEY=
NESSIE_API_KEY=
NESSIE_BASE_URL=
NESSIE_PROFILE= # verified profile JSON, for Vercel; never use the unverified example
NESSIE_PROFILE_PATH= # optional local file instead of JSON
NESSIE_TREASURY_ACCOUNT_ID=
NESSIE_ENABLED=false
FUNDING_PAUSED=false
DEMO_GENERATION_ID=demo-v1
